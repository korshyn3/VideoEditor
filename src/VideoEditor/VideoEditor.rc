//
// Dialog
//

IDD_EDITOR DIALOGEX 0, 0, 640, 400
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
CAPTION "Editor de video"
MENU IDR_MENU_PRINCIPAL
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Importar…",IDC_BTN_IMPORTAR,7,7,60,14
