/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_PRINCIPAL MENU
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Importar…\tCtrl+I",          ID_ARCHIVO_IMPORTAR
        MENUITEM SEPARATOR
        MENUITEM "&Salir",                      ID_ARCHIVO_SALIR
    END
    POPUP "&Editar"
    BEGIN
        MENUITEM "&Dividir en el cursor	S",   ID_EDITAR_DIVIDIR
        MENUITEM SEPARATOR
        MENUITEM "&Eliminar clip	Supr",       ID_EDITAR_ELIMINAR
        MENUITEM "Eliminar clip y cerrar el &hueco	Shift+Supr", ID_EDITAR_ELIMINAR_RIPPLE
        MENUITEM SEPARATOR
        MENUITEM "Des&vincular audio",          ID_EDITAR_DESVINCULAR_AUDIO
        MENUITEM SEPARATOR
        MENUITEM "Agregar &transición",         ID_EDITAR_AGREGAR_TRANSICION
        MENUITEM "&Quitar transición",          ID_EDITAR_QUITAR_TRANSICION
    END
    POPUP "&Reproducción"
    BEGIN
        MENUITEM "Reproducir / &Pausa	Espacio", ID_REPRODUCIR_PLAY
    END
    POPUP "&Pistas"
    BEGIN
        MENUITEM "Agregar pista de &video",     ID_PISTAS_AGREGAR_VIDEO
        MENUITEM "Agregar pista de &audio",     ID_PISTAS_AGREGAR_AUDIO
        MENUITEM SEPARATOR
        MENUITEM "&Eliminar pista seleccionada", ID_PISTAS_ELIMINAR
    END
    POPUP "A&yuda"
    BEGIN
        MENUITEM "&Acerca de…",                 ID_AYUDA_ACERCA
    END
END

IDR_MENU_CONTEXTO_CLIP MENU
BEGIN
    POPUP "Clip"
    BEGIN
        MENUITEM "&Dividir en el cursor	S",   ID_EDITAR_DIVIDIR
        MENUITEM SEPARATOR
        MENUITEM "&Eliminar	Supr",            ID_EDITAR_ELIMINAR
        MENUITEM "Eliminar y cerrar el &hueco	Shift+Supr", ID_EDITAR_ELIMINAR_RIPPLE
        MENUITEM SEPARATOR
        MENUITEM "Des&vincular audio",          ID_EDITAR_DESVINCULAR_AUDIO
        MENUITEM SEPARATOR
        MENUITEM "Agregar &transición",         ID_EDITAR_AGREGAR_TRANSICION
    END
END

IDR_MENU_CONTEXTO_TRANSICION MENU
BEGIN
    POPUP "Transición"
    BEGIN
        MENUITEM "&Quitar transición	Supr",   ID_EDITAR_QUITAR_TRANSICION
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_ACCEL_PRINCIPAL ACCELERATORS
BEGIN
    "I",            ID_ARCHIVO_IMPORTAR,    VIRTKEY, CONTROL, NOINVERT
    VK_SPACE,       ID_REPRODUCIR_PLAY,     VIRTKEY, NOINVERT
    "S",            ID_EDITAR_DIVIDIR,      VIRTKEY, NOINVERT
    VK_DELETE,      ID_EDITAR_ELIMINAR,     VIRTKEY, NOINVERT
    VK_DELETE,      ID_EDITAR_ELIMINAR_RIPPLE, VIRTKEY, SHIFT, NOINVERT
END


