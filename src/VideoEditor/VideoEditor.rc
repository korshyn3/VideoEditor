    EDITTEXT        IDC_FX_VALOR1,132,96,38,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_FX_ETQ2,0,114,42,8
    CONTROL         "",IDC_FX_SLIDER2,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,42,112,88,14
